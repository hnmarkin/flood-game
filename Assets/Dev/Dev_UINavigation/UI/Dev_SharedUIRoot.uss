.ui-navigation-root {
    flex-grow: 1;
}

.ui-navigation-layer,
.ui-navigation-host {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

.ui-navigation-preparationcards {
    justify-content: center;
    align-items: center;
    padding-left: 112px;
}

.ui-navigation-extrainfo {
    justify-content: center;
}
