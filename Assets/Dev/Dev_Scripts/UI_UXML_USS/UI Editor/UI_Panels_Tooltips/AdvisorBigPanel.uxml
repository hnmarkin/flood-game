                <ui:VisualElement name="col_1" style="flex-grow: 1; flex-shrink: 1; width: 116px; margin-right: 1px; margin-top: 1px; margin-bottom: 1px; margin-left: 1px; padding-top: 1px; padding-right: 1px; padding-bottom: 1px; padding-left: 1px; height: 283px; flex-wrap: wrap; min-width: 116px; max-width: 116px;">
