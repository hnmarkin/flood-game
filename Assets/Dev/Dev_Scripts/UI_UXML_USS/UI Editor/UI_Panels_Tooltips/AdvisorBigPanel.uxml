                                    <ui:Label text="May 12, 10:24 AM" style="color: rgb(62, 255, 0); margin-top: 1px; margin-right: 1px; margin-bottom: 1px; margin-left: 1px; padding-top: 1px; padding-right: 1px; padding-bottom: 1px; padding-left: 1px; white-space: normal;" />
