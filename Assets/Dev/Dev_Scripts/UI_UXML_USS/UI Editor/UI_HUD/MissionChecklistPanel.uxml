                        </ui:VisualElement>
                        <ui:Label text="Place 3 barriers" name="mission_obj_1" style="-unity-font-definition: url(&quot;project://database/Assets/Dev/Ash_dev/Pixel_Font/PublicPixel.ttf?fileID=12800000&amp;guid=29da3f0434479411c8f4a5469b7d44d9&amp;type=3#PublicPixel&quot;); margin-top: 1px; margin-right: 1px; margin-bottom: 1px; margin-left: 1px; padding-top: 1px; padding-right: 1px; padding-bottom: 1px; padding-left: 1px; font-size: 3px; color: rgb(255, 255, 255); flex-grow: 0;" />
                        <ui:Label text="0/3" name="mission_obj_count" style="-unity-font-definition: url(&quot;project://database/Assets/Dev/Ash_dev/Pixel_Font/PublicPixel.ttf?fileID=12800000&amp;guid=29da3f0434479411c8f4a5469b7d44d9&amp;type=3#PublicPixel&quot;); margin-top: 1px; margin-right: 1px; margin-bottom: 1px; margin-left: 1px; padding-top: 1px; padding-right: 1px; padding-bottom: 1px; padding-left: 1px; font-size: 3px; color: rgb(255, 255, 255);" />
                    </ui:VisualElement>
                    <ui:VisualElement name="mission_checklist_1" style="flex-grow: 0; flex-direction: row; background-image: none; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; border-top-color: rgb(52, 58, 154); border-top-left-radius: 1px; border-top-right-radius: 1px; border-bottom-right-radius: 1px; border-bottom-left-radius: 1px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(52, 58, 154); border-bottom-color: rgb(52, 58, 154); border-right-color: rgb(52, 58, 154); margin-bottom: 1px; margin-top: 1px; margin-right: 1px; margin-left: 1px;">
                        <ui:VisualElement name="checkbox" style="flex-grow: 0; align-self: center;">
                            <ui:VisualElement name="VisualElement" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Dev/Ash_dev/dev_imgs/UI_Icons/Incorrect_Checkbox_icon.png?fileID=21300000&amp;guid=994960eb9185f49e6b85721b8e645797&amp;type=3#Incorrect_Checkbox_icon&quot;); height: 5px; width: 5px;" />
                        </ui:VisualElement>
                        <ui:Label text="Evacuate risky zones" name="mission_obj_1" style="-unity-font-definition: url(&quot;project://database/Assets/Dev/Ash_dev/Pixel_Font/PublicPixel.ttf?fileID=12800000&amp;guid=29da3f0434479411c8f4a5469b7d44d9&amp;type=3#PublicPixel&quot;); margin-top: 1px; margin-right: 1px; margin-bottom: 1px; margin-left: 1px; padding-top: 1px; padding-right: 1px; padding-bottom: 1px; padding-left: 1px; font-size: 3px; color: rgb(255, 255, 255); flex-grow: 0;" />
                        <ui:Label text="0/2" name="mission_obj_count" style="-unity-font-definition: url(&quot;project://database/Assets/Dev/Ash_dev/Pixel_Font/PublicPixel.ttf?fileID=12800000&amp;guid=29da3f0434479411c8f4a5469b7d44d9&amp;type=3#PublicPixel&quot;); margin-top: 1px; margin-right: 1px; margin-bottom: 1px; margin-left: 1px; padding-top: 1px; padding-right: 1px; padding-bottom: 1px; padding-left: 1px; font-size: 3px; color: rgb(255, 255, 255);" />
