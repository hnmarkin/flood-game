VisualElement {}

.prep-card-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    flex-grow: 1;
    padding: 12px 16px 12px 112px;
    background-color: rgba(0, 0, 0, 0.28);
}

.prep-card-container {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    background-color: rgba(0, 0, 0, 0.89);
    padding: 8px;
}

.prep-card-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.prep-card-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    flex-grow: 0;
    width: 100%;
    min-width: 0;
    padding-right: 0;
}

.prep-card {
    width: 47%;
    min-width: 0;
    flex-grow: 0;
    flex-shrink: 0;
    margin: 3px;
    padding: 4px;
    background-image: url("project://database/Assets/Dev/Ash_dev/dev_imgs/UI_imgs/UI%20Panels/03_DarkBlueFrame.png?fileID=21300000&guid=e79c60e1e975641c7827d2ae9c7da75a&type=3#03_DarkBlueFrame");
}

.prep-card:hover {
    translate: 1px -1px;
}

.prep-card-content {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    margin: 2px;
    padding: 2px;
    overflow: hidden;
}

.prep-card-title {
    font-size: 5px;
    -unity-text-align: upper-center;
    white-space: normal;
    overflow: hidden;
    border-bottom-width: 1px;
    border-bottom-color: rgb(52, 58, 154);
    margin-bottom: 2px;
    padding-bottom: 2px;
}

.prep-card-field {
    min-width: 0;
    white-space: normal;
    overflow: hidden;
    flex-shrink: 1;
}

.prep-card-description {
    min-width: 0;
    white-space: normal;
    overflow: hidden;
    flex-shrink: 1;
    margin-top: 2px;
}

.prep-card-disabled {
    opacity: 0.45;
}

#prep_card_scroll .unity-scroll-view__vertical-scroller,
#prep_card_scroll .unity-scroller,
#prep_card_scroll .unity-scroller__slider,
#prep_card_scroll .unity-scroller__low-button,
#prep_card_scroll .unity-scroller__high-button {
    display: none;
    width: 0;
}

#prep_card_scroll .unity-scroll-view__content-and-vertical-scroll-container,
#prep_card_scroll .unity-scroll-view__content-viewport {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}
