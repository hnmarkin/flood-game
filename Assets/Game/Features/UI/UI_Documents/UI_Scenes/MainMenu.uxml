                <ui:Label text="Surge City 2.0" style="flex-wrap: wrap; align-self: center; -unity-font-definition: url(&quot;project://database/Assets/Dev/Ash_dev/Pixel_Font/PublicPixel.ttf?fileID=12800000&amp;guid=29da3f0434479411c8f4a5469b7d44d9&amp;type=3#PublicPixel&quot;); font-size: 20px; -unity-font-style: bold; color: rgb(52, 53, 255); white-space: normal; text-shadow: 1px 1px 0 rgba(0, 0, 0, 0); -unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 1px;" />
            </ui:VisualElement>
