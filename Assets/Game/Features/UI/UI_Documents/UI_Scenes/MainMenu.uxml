<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="PhaseSelection" src="project://database/Assets/Dev/Dev_Scripts/UI_UXML_USS/UI%20Editor/UI_Scenes/PhaseSelection.uxml?fileID=9197481963319205126&amp;guid=896b6722f61fa489ca850ba4f5921d0e&amp;type=3#PhaseSelection" />
    <Style src="project://database/Assets/Dev/Dev_Scripts/UI_UXML_USS/UI%20Editor/UI_Scenes/MainMenu.uss?fileID=7433441132597879392&amp;guid=df9857024f15476c9f02d7dc5fa1260d&amp;type=3#MainMenu" />
    <ui:VisualElement name="main_root" class="main-root" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Dev/Ash_dev/dev_imgs/UI_imgs/UI_background_imgs/allbackgroundstars.png?fileID=21300000&amp;guid=b79331ee44ebf473ba9603bb54ecc90d&amp;type=3#allbackgroundstars&quot;); flex-shrink: 0; flex-wrap: wrap; -unity-background-scale-mode: stretch-to-fill;">
