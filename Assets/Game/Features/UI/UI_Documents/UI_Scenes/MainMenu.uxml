                <ui:Label text="Main Menu" style="flex-wrap: wrap; color: rgb(255, 255, 255); -unity-text-align: upper-center; white-space: normal; text-shadow: 1px 1px 0 rgba(0, 0, 0, 0); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0); font-size: 15px;" />
            </ui:VisualElement>
            <ui:VisualElement name="buttons_row" style="flex-grow: 1; flex-shrink: 0; flex-direction: column; align-content: center; flex-wrap: wrap; background-position-y: top 0; justify-content: center;">
                <ui:Button text="START GAME" name="start_btn" class="game-button" style="flex-wrap: wrap; -unity-font-definition: url(&quot;project://database/Assets/Dev/Ash_dev/Pixel_Font/PublicPixel.ttf?fileID=12800000&amp;guid=29da3f0434479411c8f4a5469b7d44d9&amp;type=3#PublicPixel&quot;); background-image: url(&quot;project://database/Assets/Dev/Ash_dev/dev_imgs/UI_imgs/UI%20Panels/UI_Flat_Frame_Green.png?fileID=21300000&amp;guid=297a054d03cd9496faede1926b742f2c&amp;type=3#UI_Flat_Frame_Green&quot;); -unity-background-scale-mode: stretch-to-fill; color: rgb(0, 0, 0); font-size: 8px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(188, 188, 188, 0); white-space: normal; align-self: center; align-content: center; justify-content: center; margin-bottom: 10px;" />
                <ui:Button text="SETTINGS" name="settings_btn" style="flex-wrap: wrap; -unity-font-definition: url(&quot;project://database/Assets/Dev/Ash_dev/Pixel_Font/PublicPixel.ttf?fileID=12800000&amp;guid=29da3f0434479411c8f4a5469b7d44d9&amp;type=3#PublicPixel&quot;); background-image: url(&quot;project://database/Assets/Dev/Ash_dev/dev_imgs/UI_imgs/UI%20Panels/UI_Flat_Frame02a.png?fileID=21300000&amp;guid=8af5486b054cb4f3bbe947c1b23458e3&amp;type=3#UI_Flat_Frame02a&quot;); -unity-background-scale-mode: stretch-to-fill; color: rgb(0, 0, 0); font-size: 8px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(188, 188, 188, 0); white-space: normal; align-self: center; align-content: center; justify-content: center; margin-bottom: 10px;" />
