/* Layout */
.hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    padding-top: 10px;
    padding-right: 14px;
    padding-bottom: 0;
    padding-left: 14px;
    align-items: stretch;
    justify-content: flex-start;
}

.top-hud {
    width: 100%;
    flex-direction: row;
    align-items: flex-start;
    justify-content: center;
}

.top-resource-bar,
.pixel-panel {
    width: 100%;
    min-height: 25px;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    justify-content: flex-start;
    overflow: hidden;
    background-color: rgba(7, 19, 33, 0.93);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgb(88, 200, 232);
    border-right-color: rgb(88, 200, 232);
    border-bottom-color: rgb(88, 200, 232);
    border-left-color: rgb(88, 200, 232);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
}

/* Resource Cells */
.resource-cell {
    min-height: 25px;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-start;
    padding-top: 8px;
    padding-right: 12px;
    padding-bottom: 8px;
    padding-left: 12px;
    background-color: rgba(14, 33, 53, 0.9);
    border-right-width: 1px;
    border-right-color: rgba(88, 200, 232, 0.25);
}

.resource-cell--phase {
    width: 136px;
}

.resource-cell--budget {
    width: 156px;
}

.resource-cell--turn {
    width: 122px;
}

.resource-cell--population {
    width: 150px;
}

.resource-cell--zones {
    width: 118px;
}

.resource-cell--storm {
    min-width: 260px;
    flex-grow: 1;
    padding-right: 8px;
    background-color: rgba(10, 25, 42, 0.95);
    border-right-width: 0;
}

.resource-text-group {
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
}

.resource-text-group--center {
    align-items: flex-end;
    margin-right: 10px;
}

.storm-text-group {
    width: 100%;
}

/* Text */
.resource-label {
    font-size: 4px;
    color: rgb(137, 168, 187);
    margin-bottom: 2px;
}

.resource-value {
    font-size: 15px;
    color: rgb(235, 248, 255);
}

.resource-value--warning {
    color: rgb(255, 191, 83);
}

.resource-value--green {
    color: rgb(121, 229, 123);
}

.resource-subvalue {
    font-size: 8px;
    color: rgb(142, 180, 200);
    margin-top: 1px;
}


/* Storm Gauge */
.storm-gauge-row {
    width: 100%;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-start;
}

.storm-gauge {
    height: 12px;
    min-height: 12px;
    margin-left: 10px;
    margin-right: 10px;
    padding-top: 3px;
    padding-right: 3px;
    padding-bottom: 3px;
    padding-left: 3px;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    background-color: rgba(3, 14, 27, 0.95);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(88, 200, 232, 0.22);
    border-right-color: rgba(88, 200, 232, 0.22);
    border-bottom-color: rgba(88, 200, 232, 0.22);
    border-left-color: rgba(88, 200, 232, 0.22);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
}

.gauge-segment {
    min-width: 16px;
    margin-right: 3px;
    background-color: rgb(28, 47, 68);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
}

.gauge-segment--filled {
    background-color: rgb(100, 215, 238);
}

.gauge-segment--empty {
    background-color: rgb(26, 46, 65);
}

