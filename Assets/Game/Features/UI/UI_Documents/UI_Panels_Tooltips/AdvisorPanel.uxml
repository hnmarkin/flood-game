<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="AdvisorMain" src="project://database/Assets/Dev/Dev_Scripts/UI_UXML_USS/UI%20Editor/UI_Panels_Tooltips/AdvisorMain.uxml?fileID=9197481963319205126&amp;guid=18094d459f16e496daaabff390ff22c8&amp;type=3#AdvisorMain" />
    <Style src="project://database/Assets/Dev/Dev_Scripts/UI_UXML_USS/UI%20Editor/UI_Panels_Tooltips/AdvisorPanel.uss?fileID=7433441132597879392&amp;guid=bc0d18844813b4e79b15ad69d2469d95&amp;type=3#AdvisorPanel" />
    <Style src="project://database/Assets/Dev/Dev_Scripts/UI_UXML_USS/UI%20Editor/UI_Shared_USS/SharedGameButtons.uss?fileID=7433441132597879392&amp;guid=5ed9efcdb964e413d9e641bbcd436d9d&amp;type=3#SharedGameButtons" />
    <ui:VisualElement name="advisor_panel_root" style="flex-grow: 0; -unity-font-definition: url(&quot;project://database/Assets/Dev/Ash_dev/Pixel_Font/PublicPixel.ttf?fileID=12800000&amp;guid=29da3f0434479411c8f4a5469b7d44d9&amp;type=3#PublicPixel&quot;); font-size: 5px; color: rgb(255, 255, 255); top: 40%; align-self: flex-end; flex-shrink: 0; flex-wrap: wrap;">
        <ui:VisualElement name="advisor_panel_full" style="flex-grow: 0; flex-shrink: 0; flex-wrap: wrap;">
            <ui:VisualElement name="advisor_panel_container" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Dev/Ash_dev/dev_imgs/UI_imgs/UI%20Panels/03_DarkBlueFrame.png?fileID=21300000&amp;guid=e79c60e1e975641c7827d2ae9c7da75a&amp;type=3#03_DarkBlueFrame&quot;); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; width: auto; flex-direction: row; padding-top: 3px; padding-right: 3px; padding-bottom: 3px; padding-left: 3px; height: auto; flex-shrink: 0; flex-wrap: wrap;">
                <ui:VisualElement name="advisor_panel_icon_box" style="flex-grow: 0; flex-shrink: 0; flex-wrap: wrap;">
                    <ui:VisualElement name="advisor_panel_icon" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Dev/Ash_dev/dev_imgs/UI_Icons/npc_portrait.png?fileID=2800000&amp;guid=1ad165e18a1cf4444bb1575df671c45c&amp;type=3#npc_portrait&quot;); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(52, 58, 154); border-right-color: rgb(52, 58, 154); border-top-color: rgb(52, 58, 154); border-bottom-color: rgb(52, 58, 154); flex-shrink: 0; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; flex-wrap: wrap; -unity-background-scale-mode: scale-to-fit; border-top-left-radius: 1px; border-top-right-radius: 1px; border-bottom-right-radius: 1px; border-bottom-left-radius: 1px; height: 50px; width: 50px; min-width: 50px; min-height: 50px;" />
                </ui:VisualElement>
                <ui:VisualElement name="advisor_panel_box" style="flex-grow: 0; flex-direction: column; margin-top: 1px; margin-right: 1px; margin-bottom: 2px; margin-left: 0; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 0; background-color: rgba(0, 0, 0, 0); border-left-color: rgb(52, 58, 154); border-right-color: rgb(52, 58, 154); border-top-color: rgb(52, 58, 154); border-bottom-color: rgb(52, 58, 154); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; flex-shrink: 0; max-height: none; flex-wrap: wrap;">
                    <ui:VisualElement name="advisor_panel_header" style="flex-grow: 0; flex-direction: row; height: auto; flex-shrink: 0; flex-wrap: wrap;">
                        <ui:VisualElement name="advisor_header_box" style="flex-grow: 11; margin-top: 1px; margin-right: 1px; margin-bottom: 1px; margin-left: 1px; flex-shrink: 0; flex-wrap: wrap;">
                            <ui:Label text="AI ADVISOR" name="npc_advisor_title" style="font-size: 5px; margin-top: 1px; margin-right: 1px; margin-bottom: 1px; margin-left: 1px; padding-top: 1px; padding-right: 1px; padding-bottom: 1px; padding-left: 1px; height: 5px; white-space: normal; flex-wrap: wrap;" />
                            <ui:Label text="Emergency Manager" name="npc_job" style="font-size: 4px; margin-top: 1px; margin-right: 1px; margin-bottom: 1px; margin-left: 1px; padding-top: 1px; padding-right: 1px; padding-bottom: 1px; padding-left: 1px; color: rgb(255, 192, 0); flex-wrap: wrap; white-space: normal;" />
                        </ui:VisualElement>
                        <ui:VisualElement name="minimize_btn_box" style="flex-grow: 0; flex-direction: row; flex-wrap: wrap; flex-shrink: 0; align-self: stretch;">
                            <ui:Button name="advisor_minimize_button" text="X" class="game-button" style="background-image: url(&quot;project://database/Assets/Dev/Ash_dev/dev_imgs/UI_imgs/UI%20Panels/UI_Flat_Frame01a.png?fileID=21300000&amp;guid=58d95de73eebe4116aedf3593ad8896e&amp;type=3#UI_Flat_Frame01a&quot;); background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); margin-top: 1px; margin-right: 1px; margin-bottom: 1px; margin-left: 1px; padding-top: 6px; padding-right: 5px; padding-bottom: 6px; padding-left: 5px; width: 5px; height: 5px; align-self: center; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 4px; -unity-font-style: bold; color: rgb(0, 0, 0); flex-wrap: wrap; white-space: normal;" />
                            <ui:Button name="advisor_expand_btn" text="&gt;" class="game-button" style="background-image: url(&quot;project://database/Assets/Dev/Ash_dev/dev_imgs/UI_imgs/UI%20Panels/UI_Flat_Frame_Green.png?fileID=21300000&amp;guid=297a054d03cd9496faede1926b742f2c&amp;type=3#UI_Flat_Frame_Green&quot;); background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); margin-top: 1px; margin-right: 0; margin-bottom: 1px; margin-left: 1px; padding-top: 6px; padding-right: 5px; padding-bottom: 6px; padding-left: 5px; width: 5px; height: 5px; align-self: center; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 5px; -unity-font-style: bold; color: rgb(0, 0, 0); flex-wrap: wrap; white-space: normal;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="advisor_label_box" style="flex-grow: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgb(52, 58, 154); border-right-color: rgb(52, 58, 154); border-top-color: rgb(52, 58, 154); border-bottom-color: rgb(52, 58, 154); background-color: rgb(0, 0, 0); padding-top: 1px; padding-right: 1px; padding-bottom: 1px; padding-left: 1px; margin-top: 1px; height: auto; flex-shrink: 0; margin-right: 1px; margin-bottom: 1px; margin-left: 1px; flex-wrap: wrap; width: 125px;">
                        <ui:Label text="The river is rising fast.&#10;Focus on placing barriers along the north bank to protect the hospital." name="advisor_label" style="margin-top: 0; margin-right: 1px; margin-bottom: 1px; margin-left: 1px; padding-top: 2px; padding-right: 1px; padding-bottom: 2px; padding-left: 2px; flex-shrink: 0; white-space: normal; font-size: 6px; -unity-text-align: middle-left; word-spacing: 4px; letter-spacing: 2px; flex-grow: 0; flex-wrap: wrap; -unity-font-definition: url(&quot;project://database/Assets/Dev/Old_UI_Ref/Fonts/PixelifySans-VariableFont_wght.ttf?fileID=12800000&amp;guid=cd2687f93a272404fbe36b01ac511ec9&amp;type=3#PixelifySans-VariableFont_wght&quot;);" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="advisor_panel_collapse" style="flex-grow: 0; height: 24px; width: 48px; display: none;">
            <ui:Button text="ADVISOR" name="advisor_collapse_btn" style="background-image: url(&quot;project://database/Assets/Dev/Ash_dev/dev_imgs/UI_imgs/UI%20Panels/03_DarkBlueFrame.png?fileID=21300000&amp;guid=e79c60e1e975641c7827d2ae9c7da75a&amp;type=3#03_DarkBlueFrame&quot;); font-size: 4px; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Instance template="AdvisorMain" name="advisor_main_instance" style="display: none;" />
</ui:UXML>
